GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production: long random string (32+ characters). Required for secure cookies when NODE_ENV=production.
SESSION_SECRET=

# Recommended on Render, Fly, etc.: PostgreSQL URL so each professor stays signed in after restarts.
# If unset, sessions are stored as files under server/data/sessions (OK for local dev).
# DATABASE_URL=postgresql://...

# Public site URL, no trailing slash. Used to build the OAuth redirect if GOOGLE_REDIRECT_URI is unset.
# On Render, RENDER_EXTERNAL_URL is set automatically; you can still set PUBLIC_BASE_URL to a custom domain.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# Optional explicit OAuth redirect (must match Google Cloud Console exactly).
# GOOGLE_REDIRECT_URI=https://your-service.onrender.com/auth/google/callback

PORT=3847

# Google Cloud Console (OAuth 2.0 Client ID, Web application):
# - Authorized JavaScript origins: your public origin (e.g. https://your-service.onrender.com)
# - Authorized redirect URIs: same origin + /auth/google/callback
